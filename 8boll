    local edges = {{1,2},{1,3},{1,5},{2,4},{2,6},{3,4},{3,7},{4,8},{5,6},{5,7},{6,8},{7,8}}
    local overlay
    local function createOverlay()
        if overlay and overlay.Parent then return overlay end
        local parent = LocalPlayer:FindFirstChildOfClass("PlayerGui")
        if not UserInputService.TouchEnabled and type(gethui) == "function" then
            local ok, hidden = pcall(gethui)
            if ok and hidden then parent = hidden end
        end
        if not parent then return nil end
        overlay = Instance.new("ScreenGui")
        overlay.Name = "VeteranoFreeESP"
        overlay.IgnoreGuiInset = true
        overlay.ResetOnSpawn = false
        overlay.DisplayOrder = 2
        overlay.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
        pcall(function()
            overlay.ScreenInsets = UserInputService.TouchEnabled and Enum.ScreenInsets.DeviceSafeInsets or Enum.ScreenInsets.None
        end)
        if UserInputService.TouchEnabled then
            pcall(function() overlay.SafeAreaCompatibility = Enum.SafeAreaCompatibility.None end)
            pcall(function() overlay.ClipToDeviceSafeArea = true end)
        end
        if type(protect_gui) == "function" then pcall(protect_gui, overlay) end
        overlay.Parent = parent
        return overlay
    end
    local function newLine(parent)
        local line = Instance.new("Frame")
        line.Name = "ESPLine"
        line.BackgroundColor3 = COLOR
        line.BorderSizePixel = 0
        line.Active = false
        line.Visible = false
        line.AnchorPoint = Vector2.new(0.5, 0.5)
        line.Parent = parent
        return line
    end
    local function hide(bundle)
        if bundle.name then bundle.name.Visible = false end
        if bundle.tracer then bundle.tracer.Visible = false end
        for _, line in ipairs(bundle.lines) do line.Visible = false end
    end
    function o.qF(bundle)
        if bundle.name then bundle.name:Destroy() end
        if bundle.tracer then bundle.tracer:Destroy() end
        for _, line in ipairs(bundle.lines) do line:Destroy() end
    end
    function o.hideESP()
        for _, bundle in pairs(T.bundles) do hide(bundle) end
    end
    function o.cleanupESPTracer()
        if overlay then overlay:Destroy(); overlay = nil end
    end
    local function createBundle(player)
        local bundle = {lines={}}
        T.bundles[player] = bundle
        return bundle
    end
    local function renderLine(line, a, b, viewport, thickness)
        local ax, ay, bx, by = a.X, a.Y, b.X, b.Y
        if ax ~= ax or ay ~= ay or bx ~= bx or by ~= by then line.Visible = false; return end
        local dx, dy = bx - ax, by - ay
        local low, high = 0, 1
        local function clip(p, q)
            if p == 0 then return q >= 0 end
            local ratio = q / p
            if p < 0 then
                if ratio > high then return false end
                if ratio > low then low = ratio end
            else
                if ratio < low then return false end
                if ratio < high then high = ratio end
            end
            return true
        end
        if not clip(-dx, ax) or not clip(dx, viewport.X - ax)
            or not clip(-dy, ay) or not clip(dy, viewport.Y - ay) then line.Visible = false; return end
        local x1, y1 = ax + low * dx, ay + low * dy
        local x2, y2 = ax + high * dx, ay + high * dy
        dx, dy = x2 - x1, y2 - y1
        local length = math.sqrt(dx * dx + dy * dy)
        if length < 0.1 then line.Visible = false; return end
        line.Position = UDim2.fromOffset((x1 + x2) * 0.5, (y1 + y2) * 0.5)
        line.Size = UDim2.fromOffset(length, thickness or 1.4)
        line.Rotation = math.deg(math.atan2(dy, dx))
        line.Visible = true
    end
    local function render(player, bundle, camera, origin)
        local char = player.Character
        local hum = char and char:FindFirstChildOfClass("Humanoid")
        local root = char and char:FindFirstChild("HumanoidRootPart")
        if not hum or hum.Health <= 0 or not root or (root.Position - origin).Magnitude > MAX_DISTANCE then
            hide(bundle); return
        end
        local viewport = camera.ViewportSize
        if viewport.X <= 0 or viewport.Y <= 0 then hide(bundle); return end
        local head = char:FindFirstChild("Head") or root
        local headScreen = camera:WorldToViewportPoint(head.Position)
        local parent = createOverlay()
        if not parent then hide(bundle); return end
        if T.tracer and headScreen.Z > 0.5 then
            if not bundle.tracer then bundle.tracer = newLine(parent) end
            renderLine(bundle.tracer, Vector2.new(viewport.X * 0.5, 4), Vector2.new(headScreen.X, headScreen.Y), viewport)
        elseif bundle.tracer then bundle.tracer.Visible = false end

        local corners, lowY, highY, lowX, highX = {}, math.huge, -math.huge, math.huge, -math.huge
        if T.box3d or T.name then
            local lower, upper
            for _, body in ipairs(char:GetChildren()) do
                if body:IsA("BasePart") then
                    local half = body.Size * 0.5
                    local a, b = body.Position - half, body.Position + half
                    if lower then
                        lower = Vector3.new(math.min(lower.X,a.X),math.min(lower.Y,a.Y),math.min(lower.Z,a.Z))
                        upper = Vector3.new(math.max(upper.X,b.X),math.max(upper.Y,b.Y),math.max(upper.Z,b.Z))
                    else lower, upper = a, b end
                end
            end
            if lower then
                for x = 0, 1 do for y = 0, 1 do for z = 0, 1 do
                    local point = Vector3.new(x==0 and lower.X or upper.X,y==0 and lower.Y or upper.Y,z==0 and lower.Z or upper.Z)
                    local screen = camera:WorldToViewportPoint(point)
                    corners[#corners + 1] = screen
                    if screen.Z > 0.5 then
                        lowX, highX = math.min(lowX,screen.X), math.max(highX,screen.X)
                        lowY, highY = math.min(lowY,screen.Y), math.max(highY,screen.Y)
                    end
                end end end
            end
        end
        if T.box3d then
            for i, edge in ipairs(edges) do
                if not bundle.lines[i] then bundle.lines[i] = newLine(parent) end
                local a, b = corners[edge[1]], corners[edge[2]]
                if a and b and a.Z > 0.5 and b.Z > 0.5 then
                    renderLine(bundle.lines[i], Vector2.new(a.X,a.Y),Vector2.new(b.X,b.Y),viewport)
                else bundle.lines[i].Visible = false end
            end
        else
            for _, line in ipairs(bundle.lines) do line.Visible = false end
        end
        if T.name and lowX < math.huge and highX >= 0 and lowX <= viewport.X and highY >= 0 and lowY <= viewport.Y then
            if not bundle.name then
                local label = Instance.new("TextLabel")
                label.Name = "ESPName"
                label.BackgroundTransparency = 1
                label.Size = UDim2.fromOffset(220,20)
                label.AnchorPoint = Vector2.new(0.5,1)
                label.TextColor3 = COLOR
                label.TextStrokeColor3 = Color3.new(0,0,0)
                label.TextStrokeTransparency = 0.2
                label.Font = Enum.Font.GothamMedium
                label.TextSize = 13
                label.Parent = parent
                bundle.name = label
            end
            bundle.name.Text = player.Name
            bundle.name.Position = UDim2.fromOffset(math.clamp((lowX+highX)*0.5,0,viewport.X),math.max(20,lowY-3))
            bundle.name.Visible = true
        elseif bundle.name then bundle.name.Visible = false end
    end
    handleReady(Players.PlayerRemoving:Connect(function(player)
        local bundle = T.bundles[player]
        if bundle then o.qF(bundle); T.bundles[player] = nil end
    end))
    RunService:UnbindFromRenderStep("VeteranoESPAtualizacao")
    RunService:BindToRenderStep("VeteranoESPAtualizacao",Enum.RenderPriority.Camera.Value+1,function()
        if o.destroyed or not (T.box3d or T.name or T.tracer) then return end
        local camera = workspace.CurrentCamera
        if not camera then o.hideESP(); return end
        local root = isRoot()
        local origin = root and root.Position or camera.CFrame.Position
        for _, player in ipairs(Players:GetPlayers()) do
            if player ~= LocalPlayer then
                local bundle = T.bundles[player] or createBundle(player)
                local ok, problem = pcall(render,player,bundle,camera,origin)
                if not ok then
                    hide(bundle)
                    if not bundle.reportedError then
                        bundle.reportedError = true
                        warn("[VETERANO TEAM FREE] ESP: " .. tostring(problem))
                    end
                end
            end
        end
    end)
end

-- Parte do corpo fixa: cabeca; os ajustes de mira sao internos.
local function eF(char)
    local head = char:FindFirstChild("Head")
    return head and head:IsA("BasePart") and head or nil
end
local function getClosestTarget(cam, maxFov, maxDist)
    local myPos = cam.CFrame.Position
    local center = cam.ViewportSize / 2
    local best, bestD = nil, math.huge
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= LocalPlayer and not Jz.Protected(plr) then
            local char = plr.Character
            local part = char and eF(char)
            local hum = char and char:FindFirstChildOfClass("Humanoid")
            if part and hum and hum.Health > 0 and (part.Position - myPos).Magnitude <= maxDist then
                local sp, onScreen = cam:WorldToViewportPoint(part.Position)
                if onScreen and sp.Z > 0 then
                    local d = (Vector2.new(sp.X, sp.Y) - center).Magnitude
                    if d <= maxFov and d < bestD then
                        best, bestD = part, d
                    end
                end
            end
        end
    end
    return best
end

-- AIMBOT LEGIT: exige ferramenta equipada; somente ajuste suave da camera.
local aimbotConnection
local function stopAimbot()
    if aimbotConnection then aimbotConnection:Disconnect(); aimbotConnection = nil end
end
local function aimbotLoop()
    if aimbotConnection or o.destroyed then return end
    aimbotConnection = RunService.RenderStepped:Connect(function(dt)
        if o.destroyed or not T.aimbotEnabled then return end
        if UserInputService:GetFocusedTextBox() then return end
        local cam, char = workspace.CurrentCamera, LocalPlayer.Character
        local hum = char and char:FindFirstChildOfClass("Humanoid")
        if not cam or not hum or hum.Health <= 0 or not char:FindFirstChildOfClass("Tool") then return end
        local target = getClosestTarget(cam, T.aimbotFov, T.aimbotDistance)
        if not target or not target.Parent then return end
        local position = cam.CFrame.Position
        local delta = target.Position - position
        if delta.Magnitude < 0.001 then return end
        local current, desired = cam.CFrame.LookVector, delta.Unit
        local strength = math.clamp(T.aimbotSmoothness, 0.01, 1)
        local base = math.clamp(strength * 8, 0.02, 0.35)
        if current:Dot(desired) > 0.998 then base = 0.6 end
        local factor = 1 - (1 - base) ^ (math.clamp(dt, 0, 0.1) * 60)
        local look = current:Lerp(desired, factor)
        if look.Magnitude > 0.001 then
            cam.CFrame = CFrame.new(position, position + look)
        end
    end)
end
o.aimbotLoop, o.stopAimbot = aimbotLoop, stopAimbot

-- Deslocamento interno usado exclusivamente pelo farm de lixo.
do
    local M = {owner = nil, token = 0, restore = nil}
    o.travel = M
    function o.restoreTravel()
        if M.restore then M.restore() end
    end
    function M.cancel(owner)
        if owner == nil or owner == M.owner then
            M.token = M.token + 1
            o.restoreTravel()
        end
    end
    function M.to(owner, destination, active)
        if M.owner then return false, "Aguardando o deslocamento anterior terminar." end
        local char, root, hum = LocalPlayer.Character, isRoot(), isCValid()
        if o.destroyed or not char or not root or not hum or hum.Health <= 0 then
            return false, "Personagem indisponivel."
        end
        if hum.SeatPart or root.Anchored then return false, "Personagem sentado ou imobilizado." end
        if active and not active() then return false, "Deslocamento cancelado." end
        if typeof(destination) ~= "Vector3" then return false, "Destino invalido." end
        M.token = M.token + 1
        local token = M.token
        M.owner = owner
        local restored = false
        local function restore()
            if restored then return end
            restored = true
            if root.Parent then pcall(function() root.Anchored = false end) end
            if hum.Parent and hum.Health > 0 then
                pcall(function() hum:ChangeState(Enum.HumanoidStateType.GettingUp) end)
            end
        end
        M.restore = restore
        local function running()
            return not o.destroyed and token == M.token and LocalPlayer.Character == char
                and root.Parent ~= nil and hum.Parent ~= nil and hum.Health > 0
                and (not active or active())
        end
        local ok, success, reason = pcall(function()
            if not running() then return false, "Deslocamento cancelado." end
            root.Anchored = true
            hum:ChangeState(Enum.HumanoidStateType.Physics)
            root.CFrame = CFrame.new(destination)
            local deadline = os.clock() + 0.3
            repeat
                if not running() then return false, "Deslocamento cancelado." end
                task.wait(0.03)
            until os.clock() >= deadline
            restore()
            task.wait(0.25)
            if not running() then return false, "Deslocamento cancelado." end
            if (root.Position - destination).Magnitude > 6 then
                return false, "O jogo recusou o deslocamento."
            end
            return true
        end)
        restore()
        if M.restore == restore then M.restore = nil end
        M.owner = nil
        if not ok then return false, "Falha no deslocamento: " .. tostring(success) end
        return success, reason
    end
end

do
    local I = {}
    o.interact = I
    function I.position(prompt)
        local parent = prompt and prompt.Parent
        if not parent then return nil end
        if parent:IsA("Attachment") then return parent.WorldPosition end
        if parent:IsA("BasePart") then return parent.Position end
        if parent:IsA("Model") then return parent:GetPivot().Position end
        local part = parent:FindFirstAncestorWhichIsA("BasePart")
        return part and part.Position
    end
    function I.prompt(prompt, active, nativeOnly)
        local root = isRoot()
        local position = I.position(prompt)
        if not root or not position or not prompt.Enabled then return false end
        if (root.Position - position).Magnitude > prompt.MaxActivationDistance then return false end
        if active and not active() then return false end
        if not nativeOnly and type(fireproximityprompt) == "function" then
            if pcall(fireproximityprompt, prompt, math.max(0.1, prompt.HoldDuration)) then return true end
        end
        if not pcall(function() prompt:InputHoldBegin() end) then return false end
        local deadline = os.clock() + math.max(prompt.HoldDuration, 0) + 0.1
        repeat
            if not prompt.Parent or not prompt.Enabled or o.destroyed or (active and not active()) then
                pcall(function() prompt:InputHoldEnd() end)
                return false
            end
            task.wait(0.04)
        until os.clock() >= deadline
        return pcall(function() prompt:InputHoldEnd() end)
    end
end

-- ============================================================
-- FARM LIXEIRO
-- ============================================================
do
    local P2 = 10
    local LIXEIRO_TP = Vector3.new(-1216.14, 129.42, -5183.68)
    local function getTeam() return LocalPlayer.Team and LocalPlayer.Team.Name or nil end
    local function getLevel()
        local ns = LocalPlayer:FindFirstChild("NewStats")
        local lv = ns and ns:FindFirstChild("Level")
        return lv and tonumber(lv.Value) or 0
    end
    local function getEmpregos()
        local ok, mod = pcall(function() return require(ReplicatedStorage.Mercadinho.PrefModule) end)
        if not ok or type(mod) ~= "table" or type(mod.Empregos) ~= "table" then return {} end
        local list = {}
        for name, data in pairs(mod.Empregos) do
            table.insert(list, { nome = name, level = tonumber(data.Level) or 0, salario = tonumber(data.Salario) or 0 })
        end
        table.sort(list, function(a, b2)
            if a.level == b2.level then return a.nome < b2.nome end
            return a.level < b2.level
        end)
        return list
    end
    local function getLixoCount()
        local inv = LocalPlayer:FindFirstChild("Inv")
        local count = 0
        if inv then
            for _, v in ipairs(inv:GetChildren()) do
                if v.Name == "Saco de Lixo" then count = count + 1 end
            end
        end
        return count
    end
    local function getMoneySafe()
        local ls = LocalPlayer:FindFirstChild("leaderstats")
        local d = ls and ls:FindFirstChild("Dinheiro")
        return d and tonumber(d.Value) or nil
    end
    local function getLixeiroEmp()
        for _, e in ipairs(getEmpregos()) do
            if string.lower(e.nome) == "lixeiro" then return e end
        end
        return { nome = "Lixeiro", level = 1, salario = 0 }
    end
    local function setFarmStatus(msg) o.garbageFarmStatus = tostring(msg or "") end
    local function isRun(runId) return T.autoFarmLixeiroEnabled and not o.destroyed and o.garbageFarmRunId == runId end
    local function wait2(t, runId)
        local deadline = os.clock() + math.max(0, t or 0)
        repeat
            if not isRun(runId) then return false end
            task.wait(math.min(0.1, math.max(0.01, deadline - os.clock())))
        until os.clock() >= deadline
        return isRun(runId)
    end
    local function sendJobSelect(remote, emp)
        remote:FireServer(emp.nome, emp.level, true)
        local pg = LocalPlayer:FindFirstChild("PlayerGui")
        local lx = pg and pg:FindFirstChild("LixeiroUI")
        local frame = lx and lx:FindFirstChild("LixeiroFrame")
        if frame and frame.Visible then frame.Visible = false end
    end
    local function trySelectLixeiro(runId)
        if getTeam() == "Lixeiro" then return true end
        local merc = ReplicatedStorage:FindFirstChild("Mercadinho")
        local remote = merc and merc:FindFirstChild("PrefRemote")
        if not remote or not remote:IsA("RemoteEvent") then
            setFarmStatus("PrefRemote nao encontrado; aguardando o emprego.")
            return false
        end
        local emp = getLixeiroEmp()
        if getLevel() < emp.level then
            setFarmStatus("Nivel insuficiente para o emprego de lixeiro.")
            return false
        end
        setFarmStatus("Selecionando lixeiro...")
        remote:FireServer(emp.nome, emp.level)
        wait2(0.25, runId)
        if not isRun(runId) then return false end
        sendJobSelect(remote, emp)
        local deadline = os.clock() + P2
        repeat
            if not isRun(runId) then return false end
            if getTeam() == "Lixeiro" then
                wait2(1.2, runId)
                return true
            end
            task.wait(0.15)
        until os.clock() >= deadline
        return false
    end
    local function isLixoPart(part, prompt)
        return part and part.Parent and part:IsA("BasePart") and part.Name == "Lixo"
            and part.Transparency < 0.95
            and (prompt and prompt.Parent == part and prompt:IsA("ProximityPrompt") and prompt.Enabled)
    end
    local function scanLixos()
        local root = isRoot()
        local folder = workspace:FindFirstChild("Lixeiro")
        local list = {}
        if not root or not folder then return list end
        for _, part in ipairs(folder:GetChildren()) do
            local prompt = part:FindFirstChild("PegarLixo")
            if isLixoPart(part, prompt) then
                table.insert(list, { parte = part, prompt = prompt, posicao = part.Position, distancia = (part.Position - root.Position).Magnitude })
            end
        end
        table.sort(list, function(a, b3) return a.distancia < b3.distancia end)
        return list
    end
    local function inRange(root, part, prompt)
        if not root or not part or not part.Parent then return false end
        local maxD = prompt and math.max(2.5, prompt.MaxActivationDistance - 0.65) or 4.25
        return (root.Position - part.Position).Magnitude <= maxD
    end
    local function teleportTo(part, prompt, runId)
        local root = isRoot()
        if not root or not part or not part.Parent or not isRun(runId) then return false end
        if inRange(root, part, prompt) then return true end
        local position = prompt and o.interact.position(prompt) or part.Position
        if not position then return false end
        local above = math.min(part.Size.Y * 0.5 + 2.5, prompt and prompt.MaxActivationDistance * 0.6 or 3)
        local moved, reason = o.travel.to("garbage", position + Vector3.new(0, above, 0), function()
            return isRun(runId) and part.Parent ~= nil and (not prompt or prompt.Parent ~= nil)
        end)
        if not moved then
            if isRun(runId) then setFarmStatus(reason or "TP interrompido") end
            return false
        end
        return inRange(isRoot(), part, prompt)
    end
    local function firePrompt(prompt, nativeOnly, runId)
        if not prompt or not prompt.Parent or not prompt.Enabled then return false end
        return o.interact.prompt(prompt, function() return isRun(runId) end, nativeOnly)
    end
    local function collectOne(part, prompt, runId)
        local before = getLixoCount()
        for attempt = 1, 3 do
            if not isRun(runId) then return false end
            if not isLixoPart(part, prompt) then
                return getLixoCount() > before
            end
            local root = isRoot()
            if not inRange(root, part, prompt) then return false end
            firePrompt(prompt, attempt > 1, runId)
            if not isRun(runId) then return false end
            local deadline = os.clock() + 2.75
            repeat
                if not isRun(runId) then return false end
                if not part.Parent or part.Transparency >= 0.95 or getLixoCount() > before then return true end
                task.wait(0.1)
            until os.clock() >= deadline
        end
        return false
    end
    local function findDelivery()
        local folder = workspace:FindFirstChild("EntregaLixo")
        local lixeira = folder and folder:FindFirstChild("Lixeira")
        local prompt = lixeira and lixeira:FindFirstChild("EntregarLixo")
        if lixeira and lixeira:IsA("BasePart") and prompt and prompt:IsA("ProximityPrompt") then
            return lixeira, prompt
        end
        return nil, nil
    end
    local function deliverLixos(count, runId)
        local part, prompt = findDelivery()
        if not part or not prompt then
            setFarmStatus("Aguardando o ponto de entrega carregar...")
            return false
        end
        setFarmStatus(string.format("%d/%d coletados; indo entregar...", count, count))
        if not teleportTo(part, prompt, runId) then
            if not isRun(runId) then return false end
            return false
        end
        local beforeCount = getLixoCount()
        local beforeMoney = getMoneySafe()
        for attempt = 1, 3 do
            if not isRun(runId) then return false end
            firePrompt(prompt, attempt > 1, runId)
            if not isRun(runId) then return false end
            local deadline = os.clock() + 4
            repeat
                if not isRun(runId) then return false end
                local nowCount = getLixoCount()
                local nowMoney = getMoneySafe()
                if (beforeCount > 0 and nowCount < beforeCount) or (beforeMoney and nowMoney and nowMoney > beforeMoney) then
                    return true
                end
                task.wait(0.15)
            until os.clock() >= deadline
        end
        return false
    end
    function o.teleportLixeiro(active)
        return o.travel.to("garbage", LIXEIRO_TP, active)
    end
    local function farmLoop(runId)
        local deadline = os.clock() + 3
        while o.travel.owner and isRun(runId) and os.clock() < deadline do task.wait(0.05) end
        if not isRun(runId) then return end
        setFarmStatus("TP para o ponto do lixeiro...")
        local moved, reason = o.teleportLixeiro(function() return isRun(runId) end)
        if not isRun(runId) then return end
        if not moved then
            setFarmStatus(reason or "TP recusado")
            T.autoFarmLixeiroEnabled = false
            if o.lixeiroControl then o.lixeiroControl:Set(false, true) end
            Xz(o.garbageFarmStatus)
            return
        end
        while isRun(runId) do
            if not trySelectLixeiro(runId) then
                wait2(2, runId)
            else
                local goal = math.clamp(math.floor(tonumber(T.autoFarmLixeiroQuantidade) or 20), 1, 20)
                local collected = math.min(getLixoCount(), goal)
                while isRun(runId) and getTeam() == "Lixeiro" and collected < goal do
                    local list = scanLixos()
                    if #list == 0 then
                        setFarmStatus(string.format("Coletados %d/%d; aguardando...", collected, goal))
                        wait2(1.25, runId)
                    else
                        local target = list[1]
                        if teleportTo(target.parte, target.prompt, runId) then
                            if collectOne(target.parte, target.prompt, runId) then
                                collected = collected + 1
                                wait2(0.45, runId)
                            else
                                if not isRun(runId) then break end
                                wait2(0.35, runId)
                            end
                        else
                            if not isRun(runId) then break end
                            wait2(0.4, runId)
                        end
                    end
                end
                if not isRun(runId) then break end
                if getTeam() ~= "Lixeiro" then
                    setFarmStatus("Emprego alterado; retomando...")
