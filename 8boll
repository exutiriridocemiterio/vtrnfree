            local asset, reason = imageAsset()
            if not alive() then return end
            if not asset then fail(reason); return end

            -- O Sky e criado assim que o asset local fica pronto.
            -- Nao depende de uma espera de rede/pre-carregamento no celular.
            -- A mesma imagem ocupa todas as faces do fundo do mundo.
