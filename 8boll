                sky[property] = asset
            end
            sky.CelestialBodiesShown = false
            sky.StarCount = 0
            pcall(function() sky.SkyboxOrientation = Vector3.zero end)

            for _, object in ipairs(Lighting:GetChildren()) do
                hideOriginalSky(object)
