        if type(register) ~= "function" then
            return nil, "A imagem do ceu precisa de getcustomasset no executor."
        end
        local read = readfile or C.readfile
        local write = writefile or C.writefile
        local cached = false
        if type(read) == "function" then
            local ok, bytes = pcall(read, ASSET_FILE)
            cached = ok and type(bytes) == "string" and #bytes == EXPECTED_BYTES
                and bytes:sub(1, 8) == string.char(137,80,78,71,13,10,26,10)
        end
        if not cached then
            if type(write) ~= "function" then
                return nil, "A imagem do ceu precisa de writefile no executor."
            end
            local bytes = decodeImage()
            if not bytes or not alive() then return nil, "Carregamento cancelado." end
            local written, problem = pcall(write, ASSET_FILE, bytes)
            if not written then return nil, "Nao foi possivel preparar a imagem: " .. tostring(problem) end
        end
        if not alive() then return nil, "Carregamento cancelado." end
        local ok, asset = pcall(register, ASSET_FILE)
        if not ok or type(asset) ~= "string" or asset == "" then
            return nil, "O executor nao conseguiu registrar a imagem local."
        end
        return asset
    end

    -- Mantem a iluminacao local diurna, inclusive quando o ciclo do jogo muda.
    local function maintainDaylight()
        if not alive() or not sky or sky.Parent ~= Lighting or fixingDaylight then return end
        fixingDaylight = true
        local ok, problem = pcall(function()
            for property, target in pairs(daylightPreset) do
                local current = Lighting[property]
                if current ~= target then
                    originalLighting[property] = current
                    Lighting[property] = target
                end
            end
            for _, entry in ipairs(originalEffects) do
                local targets
                if entry.object:IsA("Atmosphere") then
                    targets = {Density=0, Haze=0, Glare=0}
                elseif entry.object:IsA("Clouds") or entry.object:IsA("ColorCorrectionEffect") then
                    targets = {Enabled=false}
                end
                if targets and entry.object.Parent ~= nil then
                    for property, target in pairs(targets) do
                        local current = entry.object[property]
                        if current ~= target then
                            entry.values[property] = current
                            entry.object[property] = target
                        end
                    end
                end
            end
        end)
        fixingDaylight = false
        if not ok and o.skyLightingError ~= tostring(problem) then
            o.skyLightingError = tostring(problem)
            warn("[VETERANO TEAM FREE] Iluminacao local: " .. tostring(problem))
        end
    end
    local function startDaylight()
        for property in pairs(daylightPreset) do
            originalLighting[property] = Lighting[property]
            guards[#guards + 1] = Lighting:GetPropertyChangedSignal(property):Connect(maintainDaylight)
        end
        maintainDaylight()
        local elapsed = 0
        guards[#guards + 1] = RunService.Heartbeat:Connect(function(dt)
            if not alive() then return end
            elapsed = elapsed + dt
            if elapsed < 0.25 then return end
            elapsed = 0
            maintainDaylight()
        end)
    end

