                    local a, b, c, d = encoded:byte(position, position + 3)
                    local va, vb, vc, vd = values[a], values[b], values[c], values[d]
                    if va == nil or vb == nil or (c ~= 61 and vc == nil) or (d ~= 61 and vd == nil) then
